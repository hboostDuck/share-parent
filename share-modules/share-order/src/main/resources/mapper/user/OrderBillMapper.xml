<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.share.user.mapper.OrderBillMapper">

    <resultMap type="OrderBill" id="OrderBillResult" autoMapping="true">
    </resultMap>

    <sql id="selectOrderBillVo">
        select id, order_id, bill_item, bill_amount, create_time, create_by, update_time, update_by, del_flag, remark from order_bill
    </sql>

    <select id="selectOrderBillList" parameterType="OrderBill" resultMap="OrderBillResult">
        <include refid="selectOrderBillVo"/>
        <where>
            <if test="orderId != null "> and order_id = #{orderId}</if>
            <if test="billItem != null  and billItem != ''"> and bill_item = #{billItem}</if>
            <if test="billAmount != null "> and bill_amount = #{billAmount}</if>
        and del_flag = 0
        </where>
    </select>

</mapper>
